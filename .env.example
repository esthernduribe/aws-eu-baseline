# Copy this file to .env and fill in your own values.
# .env is ignored by git. Never put real keys in this example file.

# Sign in with: aws login --profile baseline --region eu-north-1
# This gives temporary credentials. Never use long-lived access keys.
AWS_PROFILE=baseline
AWS_REGION=eu-north-1

# Example OpenTofu variable passed through the environment
TF_VAR_budget_email=you@example.com
